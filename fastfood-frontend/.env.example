# Backend API Base URL (e.g. Render, Railway, or local development)
VITE_API_URL=http://127.0.0.1:8000/api

# Stripe Configuration (Optional / Sandbox)
VITE_STRIPE_KEY=pk_test_your_key_here

# Laravel Reverb / WebSockets Configuration
VITE_REVERB_APP_KEY=my-app-key
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
