# KHQR Express API — Environment Variables

PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/fastfood_khqr

# ── Bakong / ABA Merchant ──────────────────────────────────────────
BAKONG_API_URL=https://api.bakong.nbc.gov.kh      # sandbox or prod
BAKONG_BANK_CODE=002                               # 001=ACLEDA 002=ABA 009=Wing
MERCHANT_NAME=FastFood KH
MERCHANT_CITY=Phnom Penh

# Bakong clearing accounts (only set if you have real accounts)
# MERCHANT_KHR_ACCOUNT=010161254
# MERCHANT_USD_ACCOUNT=010161254

# ── Security ──────────────────────────────────────────────────────
WEBHOOK_SECRET=make-this-a-long-random-string-in-production
API_KEY=dev-secret-key-change-in-production

# ── CORS ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
